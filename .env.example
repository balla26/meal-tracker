# Optional: override src/lib/firebaseConfig.ts values via environment variables instead
# of editing the file directly (e.g. if you manage secrets/config through Netlify's
# environment variable settings). None of these are secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to develop against the local Firebase Emulator Suite (npm run emulators)
# instead of a real Firebase project.
VITE_USE_FIREBASE_EMULATOR=false
