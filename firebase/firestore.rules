rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isEngineer() {
      return isSignedIn() && myProfile().role == 'engineer';
    }

    // A user can always see their own data. An engineer can see a user's data only
    // once that user has explicitly turned sharing on (Settings > Privacy).
    function canSeeUser(userId) {
      return isSignedIn() && (
        userId == request.auth.uid ||
        (isEngineer() && get(/databases/$(database)/documents/profiles/$(userId)).data.shareWithEngineer == true)
      );
    }

    match /profiles/{profileId} {
      allow read: if canSeeUser(profileId);
      allow create: if isSignedIn() && profileId == request.auth.uid;
      allow update: if isSignedIn() && profileId == request.auth.uid;
      allow delete: if false;
    }

    match /meals/{mealId} {
      allow read: if canSeeUser(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if canSeeUser(resource.data.userId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /alerts/{alertId} {
      allow read: if canSeeUser(resource.data.userId);
      allow create: if canSeeUser(request.resource.data.userId);
      allow update: if canSeeUser(resource.data.userId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}